//! haagenti·core·aspects: the one-shot Codec surface (spec §2.3).
//!
//! `compress_to` and `decompress_to` take `output` as a buffer of fixed size: its length is the space
//! there is. They write the result into `output[0..n]` and give `n`, and refuse with BufferTooSmall,
//! leaving `output` unchanged, when it does not fit. They never grow it.

invoke tome·core·error·Error;
invoke tome·core·level·{CompressionLevel, Algorithm};

/// One-shot compression.
☉ aspect Compressor {
    /// The algorithm.
    rite algorithm(&this) → Algorithm;

    /// The level this compressor was made with.
    rite level(&this) → CompressionLevel;

    /// `input`, compressed.
    rite compress(&this, input: &Vec<u8>) → Result<Vec<u8>, Error>;

    /// `input`, compressed into the front of `output`; the number of bytes written.
    rite compress_to(&this, input: &Vec<u8>, output: &Δ Vec<u8>) → Result<usize, Error>;

    /// The most bytes `compress` can give for `input_len` bytes.
    rite max_compressed_size(&this, input_len: usize) → usize;
}

/// One-shot decompression.
☉ aspect Decompressor {
    /// The algorithm.
    rite algorithm(&this) → Algorithm;

    /// `input`, decompressed.
    rite decompress(&this, input: &Vec<u8>) → Result<Vec<u8>, Error>;

    /// `input`, decompressed into the front of `output`; the number of bytes written.
    rite decompress_to(&this, input: &Vec<u8>, output: &Δ Vec<u8>) → Result<usize, Error>;

    /// `input`, decompressed, when it is at most `output_size` bytes; BufferTooSmall otherwise.
    /// Every haagenti type implements this itself (spec §2.3, §7 K1): this body is for others.
    rite decompress_with_size(&this, input: &Vec<u8>, output_size: usize) → Result<Vec<u8>, Error> {
        ≔ out = this.decompress(input)?;
        ⎇ out.len() > output_size { ⤺ Err(Error·buffer_too_small(out.len(), output_size)); }
        Ok(out)
    }
}

/// Compression and decompression together.
☉ aspect Codec: Compressor + Decompressor {
    /// A codec at level Default.
    rite new() → This;

    /// A codec at `level`.
    rite with_level(level: CompressionLevel) → This;

    /// Whether `data` compresses and decompresses back to itself. Every haagenti type implements
    /// this itself (spec §2.3, §7 K1): this body is for others.
    rite verify_roundtrip(&this, data: &Vec<u8>) → Result<bool, Error> {
        ≔ packed = this.compress(data)?;
        ≔ back = this.decompress(&packed)?;
        Ok(back == *data)
    }
}
