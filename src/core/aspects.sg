//! haagenti·core·aspects: the one-shot Codec surface (spec §2.3). `compress_to`, `decompress_to` and
//! `decompress_with_size` are out of slice 1 (B1).

invoke tome·core·error·Error;
invoke tome·core·level·{CompressionLevel, Algorithm};

/// One-shot compression.
☉ aspect Compressor {
    /// The algorithm.
    rite algorithm(&this) → Algorithm;

    /// The level this compressor was made with.
    rite level(&this) → CompressionLevel;

    /// `input`, compressed.
    rite compress(&this, input: &Vec<u8>) → Result<Vec<u8>, Error>;

    /// The most bytes `compress` can give for `input_len` bytes.
    rite max_compressed_size(&this, input_len: usize) → usize;
}

/// One-shot decompression.
☉ aspect Decompressor {
    /// The algorithm.
    rite algorithm(&this) → Algorithm;

    /// `input`, decompressed.
    rite decompress(&this, input: &Vec<u8>) → Result<Vec<u8>, Error>;
}

/// Compression and decompression together.
☉ aspect Codec: Compressor + Decompressor {
    /// A codec at level Default.
    rite new() → This;

    /// A codec at `level`.
    rite with_level(level: CompressionLevel) → This;

    /// Whether `data` compresses and decompresses back to itself. Every haagenti type implements
    /// this itself (spec §2.3, §7 K1): this body is for others.
    rite verify_roundtrip(&this, data: &Vec<u8>) → Result<bool, Error> {
        ≔ packed = this.compress(data)?;
        ≔ back = this.decompress(&packed)?;
        Ok(back == *data)
    }
}
