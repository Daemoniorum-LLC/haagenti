//! T rows, part 2: Rust's `#[test]`s in haagenti-deflate's gzip, inflate and zlib modules. The bytes
//! Rust took from flate2 (or gave it) are in the generated data (gen/gen_t_0.sg, by tests/oracle).

invoke haagenti·core·{CompressionLevel, Error};
invoke haagenti·deflate·{inflate, crc32, adler32, zlib_compress, zlib_decompress, gzip_compress,
    gzip_decompress};
invoke tome·support·{bytes, number};
invoke tome·tests_a·{report, cycle};
invoke tome·data_rows·row_bytes;
invoke tome·gen·gen_t;

/// Whether `r` is Ok with exactly `want`.
rite gives(r: Result<Vec<u8>, Error>, want: &Vec<u8>) → bool {
    ⌥ r { Ok(x) => x == *want, Err(_) => nay }
}

/// The generated bytes of the interop test `name`.
rite interop(name: &str) → Vec<u8> {
    ≔ v = gen_t(0, 0);
    ≔ vary i: usize = 0;
    ⟳ i + 4 < v.len() {
        ≔ n = number(v[i + 4]) as usize;
        ⎇ v[i + 1] == name { ⤺ row_bytes(&v, i + 5, n); }
        i = i + 5 + n;
    }
    Vec·new()
}

rite inflates(name: &str, want: &str) → bool {
    ≔ vary out: Vec<u8> = Vec·new();
    ⌥ inflate(&interop(name), &Δ out) { Ok(_) => out == bytes(want), Err(_) => nay }
}

rite zlib_round(input: &Vec<u8>, shorter: bool) → bool {
    ≔ r = zlib_compress(input, CompressionLevel·Default);
    ⎇ r.is_err() { ⤺ nay; }
    ≔ c = r.unwrap();
    ⎇ shorter && c.len() ≥ input.len() { ⤺ nay; }
    gives(zlib_decompress(&c), input)
}

rite gzip_round(input: &Vec<u8>, shorter: bool) → bool {
    ≔ r = gzip_compress(input, CompressionLevel·Default);
    ⎇ r.is_err() { ⤺ nay; }
    ≔ c = r.unwrap();
    ⎇ shorter && c.len() ≥ input.len() { ⤺ nay; }
    gives(gzip_decompress(&c), input)
}

☉ rite t_gzip() {
    report("gzip", "test_crc32", crc32(&Vec·new()) == 0 && crc32(&bytes("123456789")) == 3421780262);
    report("gzip", "test_gzip_roundtrip_empty", gzip_round(&Vec·new(), nay));
    report("gzip", "test_gzip_roundtrip_small", gzip_round(&bytes("Hello, World!"), nay));
    report("gzip", "test_gzip_roundtrip_large", gzip_round(&cycle("The quick brown fox jumps over the lazy dog. ", 10000), yea));
    report("gzip", "test_gzip_interop_decompress", gives(gzip_decompress(&interop("test_gzip_interop_decompress")),
        &bytes("Testing gzip interoperability with flate2 reference.")));
    report("gzip", "test_gzip_interop_compress", gives(gzip_compress(&bytes("Testing our gzip compression against flate2."),
        CompressionLevel·Default), &interop("test_gzip_interop_compress")));
}

☉ rite t_inflate() {
    ≔ stored: Vec<u8> = vec![1u8, 5, 0, 250, 255, 72, 101, 108, 108, 111];
    ≔ vary out: Vec<u8> = Vec·new();
    ≔ ok = ⌥ inflate(&stored, &Δ out) { Ok(_) => out == bytes("Hello"), Err(_) => nay };
    report("inflate", "test_inflate_stored", ok);
    report("inflate", "test_inflate_fixed_literal", inflates("test_inflate_fixed_literal", "A"));
    report("inflate", "test_inflate_repetitive", inflates("test_inflate_repetitive", "AAAAAAAAAAAAAAAAAAAA"));
    report("inflate", "test_inflate_mixed", inflates("test_inflate_mixed", "Hello, World! This is a test of DEFLATE compression."));
}

☉ rite t_zlib() {
    report("zlib", "test_adler32", adler32(&Vec·new()) == 1 && adler32(&bytes("a")) == 6422626
        && adler32(&bytes("abc")) == 38600999);
    report("zlib", "test_zlib_roundtrip_empty", zlib_round(&Vec·new(), nay));
    report("zlib", "test_zlib_roundtrip_small", zlib_round(&bytes("Hello, World!"), nay));
    report("zlib", "test_zlib_roundtrip_large", zlib_round(&cycle("The quick brown fox jumps over the lazy dog. ", 10000), yea));
    report("zlib", "test_zlib_interop_decompress", gives(zlib_decompress(&interop("test_zlib_interop_decompress")),
        &bytes("Testing zlib interoperability with flate2 reference.")));
    report("zlib", "test_zlib_interop_compress", gives(zlib_compress(&bytes("Testing our zlib compression against flate2."),
        CompressionLevel·Default), &interop("test_zlib_interop_compress")));
}
